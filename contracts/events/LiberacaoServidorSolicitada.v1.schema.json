{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "events/LiberacaoServidorSolicitada.v1.schema.json",
  "title": "LiberacaoServidorSolicitada v1 (payload)",
  "description": "Devolve o servidor (fim de jogo ou resposta tardia)",
  "x-produtor": "Partidas",
  "x-consumidores": "Alocador (dependencia simulada)",
  "type": "object",
  "required": [
    "partidaId",
    "motivo"
  ],
  "properties": {
    "partidaId": {
      "type": "string",
      "format": "uuid"
    },
    "servidorId": {
      "type": [
        "string",
        "null"
      ]
    },
    "motivo": {
      "type": "string",
      "minLength": 1
    }
  }
}