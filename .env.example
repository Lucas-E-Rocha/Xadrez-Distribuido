# Copie para .env para mudar os valores padrao do docker-compose.yml

# Nuvem: com MiniStack (padrao). Para a AWS real, apague AWS_ENDPOINT_URL e use credenciais reais.
AWS_ENDPOINT_URL=http://ministack:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Dependencia instavel simulada (R5)
LATENCIA_MS=1500
JITTER_MS=500
TAXA_FALHA=0.2

# Regras do jogo
SALAS_TOTAL=10
SALDO_INICIAL=1000
TIMEOUT_ALOCACAO_SEGUNDOS=10
ELO_K=32

# Mensageria
VISIBILITY_TIMEOUT=15
MAX_RECEIVE_COUNT=3

# Consumidores concorrentes (R4) e teste F2
CARTEIRA_REPLICAS=2
ATRASO_PROCESSAMENTO_MS=0
